{
  "databasePath": "./data/dnb-crate.sqlite",
  "libraryRoots": ["./library"],
  "outputRoot": "./output",
  "logLevel": "info",
  "supportedExtensions": [".wav", ".flac", ".mp3", ".m4a", ".aiff", ".aif"],
  "loudnessTargetLufs": -14,
  "truePeakCeilingDb": -1,
  "renderWorkerLimit": 1,
  "analysis": {
    "defaultEngine": "dnb-crate-dsp"
  },
  "enrichment": {
    "enabled": false,
    "contact": "",
    "musicbrainz": { "enabled": true },
    "deezer": { "enabled": true },
    "acoustid": { "apiKey": "" },
    "writePublishedBpm": true
  }
}
