# Copy to .env or export in your shell. Do not commit real paths to a private library.

# Optional path to a JSON config file. If unset, ./dnb-crate.config.json is used when present.
# DNB_CRATE_CONFIG=./dnb-crate.config.json

DNB_CRATE_DATABASE_PATH=./data/dnb-crate.sqlite
DNB_CRATE_LIBRARY_ROOTS=["./library"]
DNB_CRATE_OUTPUT_ROOT=./output
DNB_CRATE_LOG_LEVEL=info

# Optional Stage 3 overlays
# DNB_CRATE_LOUDNESS_TARGET_LUFS=-14
# DNB_CRATE_TRUE_PEAK_CEILING_DB=-1
# DNB_CRATE_RENDER_WORKER_LIMIT=1
# DNB_CRATE_FFMPEG_PATH=ffmpeg
# DNB_CRATE_FFPROBE_PATH=ffprobe
